@app.route('/guardar_venta', methods=['POST'])
def guardar_venta():
    usuario = request.form.get('usuario', 'S/U') # Evita error si falta usuario
    caja = Caja.query.filter_by(estado="Abierta").order_by(Caja.id.desc()).first()
    
    if not caja:
        flash("No hay caja abierta. Debe abrir una caja antes de registrar ventas.")
        return redirect(url_for('mostrar_ventas'))

    # Creamos la venta (total inicializado en 0 por el modelo)
    nueva_venta = Venta(usuario=usuario, caja_id=caja.id)
    db.session.add(nueva_venta)
    db.session.flush() # Para obtener el ID de nueva_venta antes del commit

    ids = request.form.getlist('id_producto[]')
    cantidades = request.form.getlist('cantidad[]')
    precios = request.form.getlist('precio_unitario[]')
    acumulado_total = 0

    for i in range(len(ids)):
        if not ids[i]: continue # Salta filas vacías
        
        cant = int(cantidades[i])
        prec = float(precios[i])
        acumulado_total += (cant * prec)

        detalle = DetalleVenta(
            id_venta=nueva_venta.id, # Ahora coincide con el modelo
            id_producto=int(ids[i]), # Ahora coincide con el modelo
            cantidad=cant,
            precio_unitario=prec
        )
        db.session.add(detalle)

    nueva_venta.total = acumulado_total # Usa el setter que definimos
    db.session.commit()
    flash("Venta guardada con éxito.")
    return redirect(url_for('mostrar_ventas'))
