# --- Base de datos (paridad local / Render / Neon) ---
# Opción "todo igual": misma Neon en la nube para PC y Render → usa la MISMA URL en:
#   - Render: variable DATABASE_URL
#   - Este archivo (.env.local, no subir a git): DATABASE_URL=postgresql://...@...neon.tech/...
# Opción "espejo": Postgres en la PC + Neon solo en Render:
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_LOCAL
#   NEON_DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
#   (scripts: sync_local_neon_render.py, run_demo_seeds_dual.py, schema_sync_neon.py)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME
# Misma base que Render (paridad total): podés poner aquí la URL de Neon en lugar de localhost.
# DATABASE_URL=postgresql://...@ep-xxx-pooler...neon.tech/neondb?sslmode=require
# Si local es Postgres distinto y Neon aparte:
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Si usás la misma Neon en la PC y en Render, definí también (copiá el valor desde el dashboard de Render):
# SECRET_KEY=...   # Mismo que Render → TV cliente / Live Wall / cookies firmadas coherentes
# BOOTSTRAP_ADMIN_EMAIL=...
# BOOTSTRAP_ADMIN_PASSWORD=...
# BOOTSTRAP_ADMIN_NAME=Administrador
# PUBLIC_SITE_URL=http://127.0.0.1:5000
# FLASK_DEBUG=0
# PUBLICO_MUESTRA_PRECIO=0
# PUBLICO_MUESTRA_STOCK_EXACTO=0

# Impresora térmica 80mm en PC mostrador (XPrinter XP-80T) — ver docs/operacion/IMPRESORA_XPRINTER_XP80T.md
# POS_IMPRESION_MODO=browser   # solo ventana Imprimir del navegador
# POS_IMPRESION_MODO=escpos    # solo térmica RAW (recomendado piso SD)
# POS_IMPRESION_MODO=both      # térmica al emitir + vista navegador
# Nombre EXACTO como en Windows (Panel impresoras). Ej. XP-80 — no XP-80C si está eliminada.
# POS_IMPRESORA_NOMBRE=XP-80
# Si el ticket se corta en el QR: POS_TICKET_TERMICA_SIN_QR=1
# EMPRESA_NOMBRE_COMERCIAL=Ferretería ...
# EMPRESA_RUT=76.xxx.xxx-x

# Cobranza: recordatorios por ventana de días (ver /creditos/cobranza)
# COBRANZA_DIAS_AVISO=7
# COBRANZA_MORA_DIAS_ATRAS=90

# OpenAI — piloto SD: IA facturas (recepciones) + foto POS + voz bodega (Whisper).
# Render: pegar OPENAI_API_KEY en Environment. Local: .env.local (no subir a git).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_DETAIL=low
# Páginas del PDF a enviar a visión (facturas largas: subir a 3–4 con cuidado de costo).
IA_FACTURA_PDF_PAGINAS=2
# Identificación por foto en POS / productos (mismo modelo si no se define aparte).
# OPENAI_MATERIAL_SKU_MODEL=gpt-4o-mini

# Cron: POST /api/creditos/cobranza/dispatch-cloud con Authorization: Bearer <secreto>
COBRANZA_DISPATCH_CRON_SECRET=cambiar_por_secreto_largo_aleatorio

# WhatsApp / integraciones: consulta de stock por texto (POST /api/wa/consulta-stock, Bearer).
# WA_CONSULTA_STOCK_SECRET=

# Re-abastecimiento: recordatorio 48h antes (POST /api/ventas/reabasto-dispatch-wa, Bearer; cron diario).
# REABASTO_WA_CRON_SECRET=

# Vales con despacho bodega (voz) sin cobro: POST /api/ventas/alertas-despachos-pendientes (Bearer).
# Si VALE_DESPACHO_ALERTAS_CRON_SECRET está vacío, se usa COBRANZA_DISPATCH_CRON_SECRET.
# VALE_DESPACHO_ALERTAS_CRON_SECRET=
# Horas desde último despacho (o fecha del vale si no hay timestamp) para considerar en riesgo (default 48).
# VALE_DESPACHO_SIN_COBRO_ALERTA_HORAS=48
# WhatsApp interno (un número) para resumen al supervisor: POST ... JSON {"send_wa_interno":true}. Si vacío, fallback WHATSAPP_VENTAS.
# VALE_DESPACHO_ALERTA_INTERNA_WA=56912345678
# JSON {"dry_run":true}: lista candidatos + dry_run_previews (textos WA interno y Slack) sin enviar.
# Opcional vista SQL: ejecutar sql/2026_05_08_vista_vales_riesgo_despacho_*.sql y usar {"use_view":true}. Ver sql/README_VISTA_VALES_RIESGO.md
# Prueba local: python scripts/smoke_alertas_vales_despacho.py
#
# Slack (opcional): mismo cron JSON {"notify_slack":true}. Solo envía si hay ≥ VALES_RIESGO_SLACK_MIN candidatos (default 1).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ERP_SLACK_WEBHOOK_URL=
# VALES_RIESGO_SLACK_MIN=3

# WhatsApp Cloud API (Meta). Phone Number ID = ID numérico del número en Meta (no el teléfono con +).
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0

# Customer 360: worker nocturno POST /api/c360/worker-noche (Bearer). Si vacío, puede usarse COBRANZA_DISPATCH_CRON_SECRET.
# C360_CRON_SECRET=

# Dashboard gerencia ROI IA (/gerencia/c360-ia-dashboard): costo diario de referencia en CLP para calcular ROI %.
# Si es 0 o no está definido, el tablero muestra N/A en ROI.
# C360_COSTO_IA_DIARIO_CLP=0

# Datos ficticios 7 días para ese dashboard (clientes marcados [demo-c360-ia]): python scripts/seed_c360_ia_dashboard_demo.py
# Limpiar: python scripts/seed_c360_ia_dashboard_demo.py --undo

# Customer 360 — venta proactiva: al subir de fase (predictor), enviar WhatsApp Cloud automático.
# Requiere WHATSAPP_CLOUD_* y URL pública absoluta para el enlace del cliente:
# C360_WA_AUTO_PHASE=1
# PUBLIC_BASE_URL=https://tu-dominio.com

# Sitio público / SEO: URL canónica (sitemap.xml, robots Sitemap:, enlaces absolutos, notificación a Google).
# En Render/producción definir la misma clave (ver render.yaml). Sin esto, el servidor puede inferir el host por request.
# PUBLIC_SITE_URL=https://www.lhexia.cl

# --- Facturación electrónica SII (Chile) ---
# Certificado .pfx del emisor (firma centralizada): NO subir al repositorio Git.
# Ubicación recomendada en el servidor / PC de desarrollo:
#   <raíz_del_proyecto>/instance/certs/emisor.pfx
# La carpeta `instance/` ya está en .gitignore de este proyecto.
# Alternativa: ruta absoluta (Windows: D:\ruta\emisor.pfx | Linux: /var/secrets/sii/emisor.pfx)
#
# SII_CERT_PFX_PATH puede ser absoluta o relativa a la raíz del ERP (carpeta que contiene app.py y services/).
# Ejemplos:
# SII_CERT_PFX_PATH=instance/certs/emisor.pfx
# SII_CERT_PFX_PATH=C:/ERP/instance/certs/emisor.pfx
#
# Clave del .pfx definida en el portal del proveedor de firma (no la confunda con el PIN del token).
SII_CERT_PFX_PATH=
SII_CERT_PFX_PASSWORD=
# Opcional: archivo UTF-8 con una sola línea = contraseña del .pfx (útil si hay caracteres especiales o BOM en .env).
# SII_CERT_PFX_PASSWORD_FILE=instance/certs/pfx_password.txt
#
# Ambiente SII para envío/consulta cuando exista cliente SOAP (Maullín = certificación, Palena = producción).
# Valores aceptados: certificacion | cert | pruebas | maullin  (→ certificación)
#                    produccion | prod | palena       (→ producción)
# La firma XML usa el mismo .pfx en ambos; este valor orienta URLs/endpoints de envío.
# Desarrollo / set simulación: certificacion (Maullín). Go-live: produccion (Palena).
SII_AMBIENTE=certificacion
# Activar envío real al SII (semilla/token/upload). Sin esto el ERP usa STUB_NO_ENVIO.
# SII_SOAP_ENABLED=1
#
# RUT emisor autorizado (ej. Santo Domingo / Gastón Rivera)
# EMPRESA_RUT=8054120-1
# EMPRESA_RAZON_SOCIAL=LUIS GASTON RIVERA PEREZ
#
# Carátula EnvioDTE (fecha y número de resolución del portal SII)
# SII_FCH_RESOLUCION=2026-05-19
# SII_NRO_RESOLUCION=0
#
# Opcional (desarrollo): al llamar /api/admin/facturacion/emitir-prueba con ?reload_env=1
# o con esta variable en el entorno del proceso, se vuelven a leer .env.qa y .env.local
# sobrescribiendo claves definidas en archivos (útil si cambió SII_CERT_PFX_PASSWORD sin reiniciar).
# ERP_RELOAD_ENV_FILES=1

# --- LhexIA Operador v0.2 (Ollama en PC sucursal; worker local) ---
# En Render/prod dejar AGENTE_OLLAMA_ENABLED=0 (Operador enrich solo en PC sucursal).
# Maylén (vitrina) en prod: VITRINA_OLLAMA_ENABLED=1 + VITRINA_OLLAMA_BASE_URL (túnel Cloudflare).
# Ver docs/VITRINA_OLLAMA_PRODUCCION.md
# VITRINA_MAYLEN_PROMPT_EXTRA=...  (opcional; alias legado VITRINA_LIZ_PROMPT_EXTRA)
# VITRINA_OLLAMA_ENABLED=1
# VITRINA_OLLAMA_BASE_URL=https://tu-tunel.trycloudflare.com
# VITRINA_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# VITRINA_OLLAMA_TIMEOUT_SEC=120
# VITRINA_OLLAMA_API_KEY=

