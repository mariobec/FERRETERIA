# Configuración local (contraseñas). Copia env_qa_EJEMPLO.txt a env_qa.txt y edítalo.
env_qa.txt
.env.qa
.env.local
.env.*
!.env.example

# Python / entorno
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/

# Flask local
instance/

# Herramientas / OS
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.DS_Store
Thumbs.db

# Respaldos locales de base de datos (pesados / sensibles)
backups/
*.dump

# Temporales Office / editor en raíz del repo
~$*
~WRL*.tmp

# DTE de laboratorio certificación SII (generados por emitir-prueba)
storage/dtes/pruebas_sii/*.xml
storage/dtes/pruebas_sii/*.zip
!storage/dtes/pruebas_sii/.gitkeep

# Artefactos locales / reportes generados
.coverage
docs/test_report_*.txt
docs/test_report_*.html
docs/test_report_ci.html
docs/test_report_full.html
docs/test_results.xml
docs/coverage_html/
Generated_image.png
Logos/
liz/

# Nunca ignorar assets/rutas públicas críticas para indexación SEO
!templates/index.html
!templates/fundador.html
!templates/sobre_nosotros.html
!templates/sobre_nosotros_2.html
!static/img/lhexia_logo.svg
