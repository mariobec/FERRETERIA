pytest tests/ --cov=app --cov=services --cov-report=term

# Solo smoke (rapido, CI)
pytest tests/ -m smoke -q --tb=no

# Solo rutas criticas
pytest tests/test_routes_criticas.py -v --cov=app --cov-report=term-missing

# Demo data
python scripts/seed_demo_data.py
```
